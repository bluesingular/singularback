# ── API proxy ─────────────────────────────────────────────────────────────────
# Base URL the Vite dev server proxies /api/* to.
# In production the same Express server serves both API and static UI.
VITE_API_URL=http://localhost:3100

# ── WebPush (Gap H — PWA) ─────────────────────────────────────────────────────
# Must match VAPID_PUBLIC_KEY in server/.env
# Generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=BNtx...
