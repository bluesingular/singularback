# ── OVH Production environment variables ──────────────────────────────────────
# Copy this to .env.prod, fill in real values, NEVER commit .env.prod to git.
#
# On the server: place at /opt/swwarm/.env.prod
# The deploy.sh script loads it automatically.

# ── App URL ────────────────────────────────────────────────────────────────────
# The public HTTPS URL — must match your DNS record
PUBLIC_URL=https://app.swwarm.com

# Docker image tag built by CI
DOCKER_IMAGE=swwarm/app:latest

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_ME_openssl_rand_base64_32

# ── OVH Managed PostgreSQL ─────────────────────────────────────────────────────
# Found in: OVH Console → Databases → your cluster → General information → Connection string
# Format: postgresql://user:password@host:port/defaultdb?sslmode=require
DATABASE_URL=postgresql://avnadmin:REPLACE_ME@postgresql-REPLACE_ME.database.cloud.ovh.net:20184/defaultdb?sslmode=require

# ── OVH Managed Redis ──────────────────────────────────────────────────────────
# Found in: OVH Console → Databases → your Redis cluster → General information
# Format: rediss://default:password@host:port
REDIS_URL=rediss://default:REPLACE_ME@redis-REPLACE_ME.database.cloud.ovh.net:20185

# ── Credential vault ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Must be exactly 64 hex chars. Store in OVH Secret Manager or a password manager.
VAULT_MASTER_KEY=REPLACE_ME_64_hex_chars

# ── LLM routing ────────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# ── Web browsing (Firecrawl) ────────────────────────────────────────────────────
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-REPLACE_ME

# ── Internal monitoring (Bull Board at /internal/queues) ───────────────────────
# Generate: openssl rand -hex 16
INTERNAL_AUTH_TOKEN=REPLACE_ME

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# https://resend.com — free tier: 3 000 emails/month
RESEND_API_KEY=re_REPLACE_ME
FROM_EMAIL=noreply@swwarm.com

# ── Stripe ──────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# From: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── OpenAI (Whisper for voice input — G11) ─────────────────────────────────────
# Optional — only required if voice transcription is used
OPENAI_API_KEY=sk-REPLACE_ME
